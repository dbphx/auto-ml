# OpenAI-compatible vLLM endpoint
VLLM_BASE_URL=https://bifrost.ai.insky.io.vn
VLLM_MODEL=MiniMax/MiniMax-M2.7-highspeed
VLLM_API_KEY=replace-with-your-api-key
# Codex mode uses these same values, but the endpoint must implement /v1/responses.
LLM_TIMEOUT_SECONDS=90
LLM_RETRIES=2
LLM_MAX_TOKENS=2048

# Training agent: llm (current planner) or codex (choose external/internal per hook)
TRAINING_AGENT_MODE=llm
# Optional Codex CLI tuning settings.
# Compose uses the logged-in host Codex session for internal mode; OPENAI_API_KEY is optional.
# OPENAI_API_KEY=replace-with-your-openai-api-key
# CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180

# Optional S3 input/output
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL=https://s3.insky.io.vn
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
# DATASET_S3_URI and OUTPUT_S3_URI are optional CLI equivalents.
# DATASET_S3_URI=s3://bucket/datasets/waf
# OUTPUT_S3_URI=s3://bucket/models/waf

# Optional generic aliases. VLLM_* takes effect when these are omitted.
# LLM_API_URL=https://bifrost.ai.insky.io.vn/v1/chat/completions
# LLM_MODEL=MiniMax/MiniMax-M2.7-highspeed
# LLM_API_KEY=replace-with-your-api-key
